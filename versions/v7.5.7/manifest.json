      "group": "交易页面",
      "pageNote": {
        "description": "真实会员开通页，承接会员类型切换、套餐选择、AI 积分说明、微信支付和权益对比。",
        "path": "由会员中心“立即开通 / 立即续费”及受限能力拦截入口进入。",
        "modules": [
          "VIP / SVIP / AI 充值切换",
          "横向滚动套餐",
          "会员每月赠送 AI 积分",
          "微信支付与协议",
          "会员权益对比"
        ]
      },
      "states": [
        {
          "id": "default",
          "name": "默认态",
          "stateNote": {
            "rule": "默认展示 VIP 会员，选中连续包年 ¥88。页面按真实设计稿 1:1 呈现，在既有手机模型内纵向滚动。"
          }
        },
        {
          "id": "single-member",
          "name": "单次卡会员",
          "stateNote": {
            "rule": "当前用户已拥有 VIP 或 SVIP 单次卡，沿用线上已开通会员逻辑，只展示当前会员权益，不展示套餐列表、协议文案和点击购买入口。"
          }
        },
        {
          "id": "subscription-renewing",
          "name": "连续会员 · 续费中",
          "stateNote": {
            "rule": "VIP / SVIP 连续包月或连续包年且自动续费仍开启时，沿用终身 SVIP 的已开通卡片，只替换等级和商品名称，副文案为“权益生效中”。不展示套餐及购买入口。"
          }
        },
        {
          "id": "subscription-canceled",
          "name": "订阅卡 · 已取消",
          "stateNote": {
