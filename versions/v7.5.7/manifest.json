          }
        },
        {
          "id": "lifetime-member",
          "name": "终身会员",
          "stateNote": {
            "rule": "VIP 终身会员仍可正常购买 SVIP 商品，预览展示 SVIP 套餐列表；SVIP 终身会员沿用线上已开通会员逻辑，不展示套餐、协议或购买入口。"
          }
        },
